# LinkedIn session — copy from a REAL Voyager GraphQL request (not the document HTML).
#
# Firefox DevTools → Network → filter "graphql" → click a 200 voyagerIdentityDashProfiles call:
#   1. Request Headers → Cookie          → LINKEDIN_COOKIES
#   2. Request Headers → csrf-token      → LINKEDIN_CSRF_TOKEN  (looks like ajax:1070…)
#
# Optional: set LINKEDIN_USER_AGENT to your browser's User-Agent string
# (must match the browser that created the cookies — Firefox vs Chrome mismatch can force logout).

LINKEDIN_COOKIES=bcookie=...; bscookie=...; li_at=...; JSESSIONID="ajax:..."; lidc=...
LINKEDIN_CSRF_TOKEN=ajax:1070442100748203159
# LINKEDIN_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64; rv:154.0) Gecko/20100101 Firefox/154.0
